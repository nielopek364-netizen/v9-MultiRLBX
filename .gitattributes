* text=auto

# Windows batch and PowerShell scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf

# Source, shell, web, and docs use LF
*.cs text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.exe binary
*.zip binary
